# Client Environment Configuration Template

# Local Development:
VITE_API_URL=http://localhost:5000/api

# Production / VPS Deployment:
# If frontend & backend are served behind Nginx reverse proxy on the same domain:
# VITE_API_URL=/api
# If backend is on a separate domain / subdomain:
# VITE_API_URL=https://api.yourdomain.com/api
