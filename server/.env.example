# Node Environment
NODE_ENV=production
PORT=5000

# Client Application URL (Comma-separated if multiple, e.g. https://yourdomain.com,https://www.yourdomain.com)
CLIENT_URL=http://localhost:5173,http://localhost:3000

# Database Connection URI
MONGO_URI=mongodb://127.0.0.1:27017/hostel_db

# Security & Authentication
JWT_SECRET=replace_with_a_super_strong_random_secret_string_here

# Gmail SMTP Email Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_digit_app_password
EMAIL_FROM="Parivartan Hostel" <your_email@gmail.com>

# Google OAuth2 Credentials (Optional / Backup)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here
